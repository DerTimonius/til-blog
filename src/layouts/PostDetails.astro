---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Header from '~/components/Header.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import Footer from '~/components/Footer.astro';
import { site } from '~/utils/config';
import Tag from '~/components/Tag.astro';
import ReadingTime from '~/components/ReadingTime.astro';
import { formatDate } from '~/utils/formatDate';
import { getRelatedPosts } from '~/utils/sortPosts';
import TOC from '~/components/TOC.astro';
import BackToTopButton from '~/components/BackToTopButton.astro';
import Link from '~/components/Link.astro';
import CommentSection from '~/components/CommentSection.astro';
import { render } from 'astro:content';

export interface Props {
	post: CollectionEntry<'blogs'>;
}

const { post } = Astro.props;

const {
	title,
	description,
	pubDate,
	tags,
	updatedAt,
	relatedPosts,
	bskyPostId,
} = post.data;

const tagsDisplay = tags.map((tag) => {
	return { name: tag, postsCount: 0 };
});
const date = formatDate(pubDate);
const updatedDate = formatDate(updatedAt!);

const relatedArticles = relatedPosts ? await getRelatedPosts(relatedPosts) : [];
const { Content, remarkPluginFrontmatter, headings } = await render(post);
const time = remarkPluginFrontmatter.minutesRead;

const backBtnClasses =
	'inline-flex items-center gap-2 font-ui text-sm font-semibold uppercase tracking-wider py-2 px-4 border-2 border-line bg-fill text-base transition-all duration-150 cursor-pointer hover:bg-card hover:shadow-[3px_3px_0_0_rgb(var(--color-text-base))] hover:-translate-x-px hover:-translate-y-px';

const sidebarSectionClasses =
	'border-[3px] border-line bg-card p-5 shadow-[4px_4px_0_0_rgb(var(--color-text-base))] transition-all duration-150 hover:shadow-[6px_6px_0_0_rgb(var(--color-accent-rgb))]';

const relatedLinkClasses =
	'block font-ui py-1 text-base no-underline underline decoration-1 underline-offset-[3px] transition-all duration-150 hover:text-accent hover:decoration-2 hover:pl-2';
---

<Layout
	title={title}
	ogImage={`/posts/${post.id}/og.png`}
	author={site.author}
	description={description}
>
	<Header />
	<BackToTopButton />

	<main id="main-content" class="flex-1" transition:name={post.id}>
		<!-- Article Header -->
		<header class="border-b-[3px] border-line px-4 py-12 sm:px-6 sm:py-16">
			<div class="mx-auto max-w-4xl">
				<!-- Breadcrumb/Back -->
				<div class="mb-6 flex items-center gap-2">
					<button class={backBtnClasses} onclick="history.back()">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
							stroke-linejoin="miter"
						>
							<line x1="19" y1="12" x2="5" y2="12"></line>
							<polyline points="12 19 5 12 12 5"></polyline>
						</svg>
						<span>Back</span>
					</button>
				</div>

				<!-- Title -->
				<h1
					data-test-id="blog-title"
					transition:name={title}
					class="font-display text-4xl leading-none tracking-wide sm:text-5xl lg:text-6xl"
				>
					{title}
				</h1>

				<!-- Meta info -->
				<div class="mt-6 flex flex-wrap items-center gap-4">
					<FormattedDate datetime={date} size="lg" />
					<span class="text-accent">•</span>
					<ReadingTime {time} size="lg" />
				</div>

				<!-- Tags -->
				<div class="mt-4 flex flex-wrap gap-2">
					{tagsDisplay.map((tag) => <Tag {tag} size="sm" />)}
				</div>
			</div>
		</header>

		<!-- Main content area -->
		<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
			<div class="grid gap-8 lg:grid-cols-[280px_1fr]">
				<!-- Sidebar with TOC -->
				<aside class="hidden lg:block">
					<div class="sticky top-8 space-y-6">
						{
							headings.length ? (
								<div class={sidebarSectionClasses}>
									<h2 class="mb-4 font-display text-xl tracking-wide">
										Contents
									</h2>
									<TOC {headings} />
								</div>
							) : null
						}

						{
							relatedArticles.length ? (
								<div class={sidebarSectionClasses}>
									<h2 class="mb-4 font-display text-xl tracking-wide">
										Related
									</h2>
									<ul class="space-y-3">
										{relatedArticles.map((post) => (
											<li>
												<Link
													href={`/posts/${post.id}`}
													className={`${relatedLinkClasses} text-sm`}
												>
													{post.data.title}
												</Link>
											</li>
										))}
									</ul>
								</div>
							) : null
						}
					</div>
				</aside>

				<!-- Article content -->
				<article role="article" class="prose max-w-[80dvw]">
					<!-- Mobile TOC Accordion -->
					{
						headings.length ? (
							<details class="mobile-toc-accordion lg:hidden mb-6 border-[3px] border-line bg-card shadow-[4px_4px_0_0_rgb(var(--color-text-base))]">
								<summary class="mobile-toc-summary list-none cursor-pointer inline-flex items-center gap-2 font-ui text-sm font-semibold uppercase tracking-wider py-2 px-4 bg-fill text-base transition-all duration-150 hover:bg-card w-full border-b-[3px] border-line">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="18"
										height="18"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="square"
										stroke-linejoin="miter"
									>
										<line x1="4" y1="9" x2="20" y2="9" />
										<line x1="4" y1="15" x2="20" y2="15" />
										<line x1="4" y1="5" x2="20" y2="5" />
									</svg>
									<span>Table of Contents</span>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="square"
										stroke-linejoin="miter"
										class="mobile-toc-chevron ml-auto"
									>
										<polyline points="6 9 12 15 18 9" />
									</svg>
								</summary>
								<div class="mobile-toc-content p-4">
									<TOC {headings} />
								</div>
							</details>
						) : null
					}

					<Content />

					{
						updatedAt && (
							<div class="mt-12 border-t-[3px] border-line pt-6">
								<p class="font-ui text-sm font-semibold tracking-wider text-accent uppercase">
									Last updated: {updatedDate}
								</p>
							</div>
						)
					}
				</article>
			</div>
		</div>

		<!-- Comments section -->
		{
			bskyPostId && (
				<div class="mx-auto max-w-4xl border-t-[3px] border-line px-4 py-12 sm:px-6">
					<CommentSection postId={bskyPostId} />
				</div>
			)
		}
	</main>

	<Footer />
</Layout>

<style>
	/* Enable smooth height animation using modern CSS */
	.mobile-toc-accordion {
		interpolate-size: allow-keywords;
	}

	.mobile-toc-content {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.35s ease;
	}

	.mobile-toc-accordion[open] .mobile-toc-content {
		grid-template-rows: 1fr;
	}

	.mobile-toc-content > * {
		overflow: hidden;
	}

	/* Rotate chevron when accordion is open */
	.mobile-toc-accordion[open] .mobile-toc-chevron {
		transform: rotate(180deg);
	}

	.mobile-toc-chevron {
		transition: transform 0.35s ease;
	}

	/* Summary hover effect matching the sidebar style */
	.mobile-toc-accordion:hover {
		box-shadow: 0 0 0 2px rgb(var(--color-accent-rgb));
	}

	.mobile-toc-summary:hover {
		box-shadow: 0 2px 0 0 rgb(var(--color-text-base));
	}
</style>
