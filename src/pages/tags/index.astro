---
import { getCollection } from 'astro:content';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import TagWithIcon from '~/components/TagWithIcon.astro';
import Layout from '~/layouts/Layout.astro';
import Main from '~/layouts/Main.astro';
import { site } from '~/utils/config';
import getTags from '~/utils/getTags';

const posts = await getCollection('blogs');

const tags = await getTags(posts);
---

<Layout title={`Tags | ${site.title}`}>
	<Header activeNav="tags" />
	<Main pageTitle="Tags" pageDesc="Browse all topics covered in this blog.">
		<div class="mb-8 border-b-[3px] border-line pb-4">
			<span
				class="font-ui text-sm font-semibold tracking-wider text-accent uppercase"
			>
				{tags.length} topics available
			</span>
		</div>

		<ul class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
			{tags.map((tag) => <TagWithIcon {tag} />)}
		</ul>
	</Main>
	<Footer />
</Layout>
