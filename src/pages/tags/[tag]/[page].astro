---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';
import Card from '~/components/Card.astro';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import PaginationButtons from '~/components/PaginationButtons.astro';
import Layout from '~/layouts/Layout.astro';
import Main from '~/layouts/Main.astro';
import { site } from '~/utils/config';
import getTags from '~/utils/getTags';
import { tagIcons } from '~/utils/tagIcons';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getCollection('blogs');
	const tags = await getTags(posts);
	return tags.flatMap(({ name }) => {
		const tagPosts = posts
			.filter((post) => {
				return post.data.tags.includes(name);
			})
			.sort((a, b) => (dayjs(a.data.pubDate).isAfter(b.data.pubDate) ? -1 : 1));
		return paginate(tagPosts, {
			params: { tag: name },
			pageSize: site.postPerPage,
		});
	});
}) satisfies GetStaticPaths;

const { tag } = Astro.params;

const { page } = Astro.props;

const Icon = tagIcons[tag as keyof typeof tagIcons] ?? tagIcons.fallback;

const tagLabelClasses =
	'inline-block font-ui text-xs font-semibold uppercase tracking-wider py-[0.35rem] px-3 border-2 border-line bg-accent text-inverted';

const tagIconClasses =
	'flex items-center justify-center h-20 w-20 sm:h-24 sm:w-24 border-[3px] border-line bg-card shadow-[4px_4px_0_0_rgb(var(--color-text-base))] transition-all duration-150 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[7px_7px_0_0_rgb(var(--color-accent-rgb))] [&_svg]:w-10 [&_svg]:h-10 [&_svg]:stroke-base sm:[&_svg]:w-12 sm:[&_svg]:h-12';
---

<Layout title={`Tag: ${tag} | ${site.title}`}>
	<Header activeNav="tags" />

	<!-- Tag Header Section -->
	<section class="border-b-[3px] border-line px-4 py-12 sm:px-6 sm:py-16">
		<div class="mx-auto max-w-4xl">
			<div
				class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
			>
				<div>
					<div class="mb-3 flex items-center gap-2">
						<span class={tagLabelClasses}>Tag</span>
						<span
							class="font-ui text-sm font-semibold tracking-wider text-accent uppercase"
						>
							{page.total} posts
						</span>
					</div>
					<h1
						class="font-display text-5xl leading-none tracking-wide sm:text-6xl"
						transition:name={tag}
					>
						{tag?.replace(/-/g, ' ')}
					</h1>
				</div>

				<div class={tagIconClasses} transition:name={`icon-${tag}`}>
					<Icon />
				</div>
			</div>
		</div>
	</section>

	<Main pageTitle="" pageDesc="" screenReaderOnly>
		<div class="mb-6 flex items-center justify-between">
			<span
				class="font-ui text-sm font-semibold tracking-wider text-accent uppercase"
			>
				Page {page.currentPage} of {page.lastPage}
			</span>
		</div>

		<ul class="grid gap-6">
			{
				page.data.map(({ data, id }) => (
					<Card
						dataTestId={`tag-post-${tag}`}
						href={`/posts/${id}`}
						frontmatter={data}
						slug={id}
					/>
				))
			}
		</ul>
	</Main>

	<PaginationButtons {page} />
	<Footer />
</Layout>
