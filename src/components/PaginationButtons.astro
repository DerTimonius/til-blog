---
import type { Page } from 'astro';

export interface Props {
	page: Page;
}

const { page } = Astro.props;

const btnClasses =
	'inline-flex items-center gap-2 font-ui text-sm font-semibold uppercase tracking-wider py-3 px-5 border-[3px] border-line bg-fill text-base shadow-[3px_3px_0_0_rgb(var(--color-text-base))] transition-all duration-150 no-underline hover:bg-accent hover:text-inverted hover:border-accent hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0_0_rgb(var(--color-text-base))] hover:no-underline';

const btnDisabledClasses =
	'opacity-40 cursor-not-allowed shadow-none hover:bg-fill hover:text-base hover:border-line hover:translate-x-0 hover:translate-y-0 hover:shadow-none';

const btnPrevClasses = 'hover:-translate-x-0.5 hover:translate-y-0.5';

const btnNextClasses = 'hover:translate-x-0.5 hover:translate-y-0.5';

const indicatorClasses =
	'inline-block font-ui text-sm font-semibold uppercase tracking-widest py-2 px-4 border-2 border-line bg-card text-base';
---

{
	page.total > 1 ? (
		<nav
			class="mx-auto mt-8 mb-12 flex max-w-4xl items-center justify-between px-4 sm:px-6"
			aria-label="Pagination"
		>
			{/* Previous Button */}
			<div class="flex-1">
				{page.url.prev ? (
					<a
						href={page.url.prev}
						class={`${btnClasses} ${btnPrevClasses}`}
						aria-label="Go to previous page"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
							stroke-linejoin="miter"
						>
							<line x1="19" y1="12" x2="5" y2="12" />
							<polyline points="12 19 5 12 12 5" />
						</svg>
						<span class="hidden sm:inline">Previous</span>
						<span class="sm:hidden">Prev</span>
					</a>
				) : (
					<span class={`${btnClasses} ${btnDisabledClasses}`}>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
							stroke-linejoin="miter"
						>
							<line x1="19" y1="12" x2="5" y2="12" />
							<polyline points="12 19 5 12 12 5" />
						</svg>
						<span class="hidden sm:inline">Previous</span>
						<span class="sm:hidden">Prev</span>
					</span>
				)}
			</div>

			{/* Page Info */}
			<div class="px-4">
				<span class={indicatorClasses}>
					{page.currentPage} / {page.lastPage}
				</span>
			</div>

			{/* Next Button */}
			<div class="flex-1 text-right">
				{page.url.next ? (
					<a
						href={page.url.next}
						class={`${btnClasses} ${btnNextClasses}`}
						aria-label="Go to next page"
					>
						<span>Next</span>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
							stroke-linejoin="miter"
						>
							<line x1="5" y1="12" x2="19" y2="12" />
							<polyline points="12 5 19 12 12 19" />
						</svg>
					</a>
				) : (
					<span class={`${btnClasses} ${btnDisabledClasses}`}>
						<span>Next</span>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
							stroke-linejoin="miter"
						>
							<line x1="5" y1="12" x2="19" y2="12" />
							<polyline points="12 5 19 12 12 19" />
						</svg>
					</span>
				)}
			</div>
		</nav>
	) : null
}
