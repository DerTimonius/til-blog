---
import type { Heading } from './TOC.astro';

interface Props {
	heading: Heading;
}

const { heading } = Astro.props;
---

<li class="brutalist-toc-item">
  <a 
    href={'#' + heading.slug} 
    aria-label={heading.text}
    class="brutalist-toc-link"
  >
    {heading.text}
  </a>
  {
    heading.subheadings && heading.subheadings.length > 0 ? (
      <ul class="brutalist-toc-sublist">
        {heading.subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    ) : null
  }
</li>

<style>
  .brutalist-toc-item {
    margin: 0;
    padding: 0;
  }

  .brutalist-toc-link {
    display: block;
    padding: 0.35rem 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(var(--color-text-base));
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
  }

  .brutalist-toc-link:hover {
    color: rgb(var(--color-accent-rgb));
    border-left-color: rgb(var(--color-accent-rgb));
    padding-left: 0.75rem;
    background-color: rgba(var(--color-accent-rgb), 0.05);
  }

  .brutalist-toc-sublist {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-left: 1rem;
    border-left: 1px solid rgb(var(--color-border-rgb));
  }

  .brutalist-toc-sublist .brutalist-toc-link {
    font-size: 0.8rem;
    opacity: 0.8;
  }
</style>
