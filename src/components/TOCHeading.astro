---
import type { Heading } from './TOC.astro';

interface Props {
	heading: Heading;
}

const { heading } = Astro.props;
---

<li class="m-0 p-0">
	<a
		href={'#' + heading.slug}
		aria-label={heading.text}
		class="block border-l-2 border-transparent px-2 py-[0.35rem] text-sm font-medium text-base no-underline transition-all duration-150 hover:border-accent hover:bg-accent/5 hover:pl-3 hover:text-accent"
	>
		{heading.text}
	</a>
	{
		heading.subheadings && heading.subheadings.length > 0 ? (
			<ul class="m-0 list-none border-l border-line p-0 pl-4">
				{heading.subheadings.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		) : null
	}
</li>
