---
import { site } from '~/utils/config';
import Link from './Link.astro';

export interface Props {
	activeNav?: 'posts' | 'tags' | 'about' | 'search';
}

const { activeNav } = Astro.props;

const navItems = [
	{ name: 'Posts', href: '/posts', id: 'posts' },
	{ name: 'Tags', href: '/tags', id: 'tags' },
	{ name: 'About', href: '/about', id: 'about' },
];
---

<header class="fixed left-0 right-0 top-0 z-50 w-full border-b-[3px] border-line bg-fill/95 backdrop-blur-sm">
  <!-- Skip to content link -->
  <a
    class="absolute -top-full left-4 z-50 border-[3px] border-line bg-accent px-4 py-2 font-ui text-sm font-semibold uppercase tracking-wider text-inverted transition-all focus:top-4"
    id="skip-to-content"
    href="#main-content"
  >
    Skip to content
  </a>

  <div class="mx-auto flex max-w-4xl flex-col items-stretch">
    <!-- Main navigation bar -->
    <div class="flex items-center justify-between px-4 py-4 sm:px-6 sm:py-5">
      <!-- Logo / Site Title -->
      <a 
        href="/" 
        class="group flex flex-col"
      >
        <span class="font-display text-2xl leading-none tracking-wide sm:text-3xl">
          {site.title}
        </span>
        <span class="font-ui text-xs font-medium uppercase tracking-wider text-accent sm:text-sm">
          Today I Learned
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden items-center gap-1 sm:flex">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`brutalist-nav-link ${activeNav === item.id ? 'active' : ''}`}
            data-test-id={`nav-link-${item.id}`}
          >
            {item.name}
          </a>
        ))}
        
        <!-- Search link -->
        <a
          href="/search"
          class={`brutalist-nav-link p-2 ${activeNav === 'search' ? 'active' : ''}`}
          aria-label="Search"
          data-test-id="nav-link-search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"
            stroke-linejoin="miter"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Theme toggle -->
        {site.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="brutalist-nav-link p-2"
            title="Toggle light & dark mode"
            aria-label="Toggle theme"
            aria-live="polite"
            data-test-id="darkmode-button"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              id="moon-svg"
              class="block h-5 w-5 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="square"
              stroke-linejoin="miter"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              id="sun-svg"
              class="hidden h-5 w-5 dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="square"
              stroke-linejoin="miter"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>
        )}
      </nav>

      <!-- Mobile menu button -->
      <button
        class="hamburger-menu brutalist-nav-link p-2 sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="square"
          stroke-linejoin="miter"
          class="menu-icon"
        >
          <line x1="3" y1="6" x2="21" y2="6" class="line-open"></line>
          <line x1="3" y1="12" x2="21" y2="12" class="line-open"></line>
          <line x1="3" y1="18" x2="21" y2="18" class="line-open"></line>
          <line x1="18" y1="6" x2="6" y2="18" class="line-close hidden"></line>
          <line x1="6" y1="6" x2="18" y2="18" class="line-close hidden"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <nav 
      id="mobile-nav" 
      class="hidden border-t-[3px] border-line bg-card sm:hidden"
    >
      <div class="flex flex-col p-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`brutalist-mobile-link ${activeNav === item.id ? 'active' : ''}`}
            data-test-id={`mobile-nav-link-${item.id}`}
          >
            {item.name}
          </a>
        ))}
        <a
          href="/search"
          class={`brutalist-mobile-link ${activeNav === 'search' ? 'active' : ''}`}
          data-test-id="mobile-nav-link-search"
        >
          Search
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Brutalist navigation link style */
  .brutalist-nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.5rem 1rem;
    border: 2px solid transparent;
    color: rgb(var(--color-text-base));
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .brutalist-nav-link:hover {
    border-color: rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-card-rgb));
    box-shadow: 3px 3px 0 0 rgb(var(--color-text-base));
    transform: translate(-1px, -1px);
  }

  .brutalist-nav-link.active {
    border-color: rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-accent-rgb));
    color: rgb(var(--color-fill-rgb));
    box-shadow: 3px 3px 0 0 rgb(var(--color-text-base));
  }

  .brutalist-nav-link.active:hover {
    background-color: rgb(var(--color-text-base));
    color: rgb(var(--color-fill-rgb));
  }

  /* Mobile navigation links */
  .brutalist-mobile-link {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1rem;
    border: 2px solid transparent;
    border-bottom: 2px solid rgb(var(--color-border-rgb));
    color: rgb(var(--color-text-base));
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .brutalist-mobile-link:last-child {
    border-bottom: none;
  }

  .brutalist-mobile-link:hover {
    border-color: rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-card-rgb));
    padding-left: 1.5rem;
  }

  .brutalist-mobile-link.active {
    background-color: rgb(var(--color-accent-rgb));
    color: rgb(var(--color-fill-rgb));
    border-color: rgb(var(--color-border-rgb));
  }

  /* Hamburger menu animation */
  .menu-icon .line-open,
  .menu-icon .line-close {
    transition: opacity 0.2s ease;
  }

  .menu-icon.is-active .line-open {
    opacity: 0;
  }

  .menu-icon.is-active .line-close {
    opacity: 1;
  }

  .menu-icon.is-active .line-close.hidden {
    display: block;
  }

  /* Theme button specific */
  #theme-btn:hover svg {
    transform: rotate(15deg);
  }

  #theme-btn svg {
    transition: transform 0.2s ease;
  }
</style>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector('.hamburger-menu');
    const menuIcon = document.querySelector('.menu-icon');
    const mobileNav = document.querySelector('#mobile-nav');

    menuBtn?.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      
      menuIcon?.classList.toggle('is-active');
      menuBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      menuBtn.setAttribute(
        'aria-label',
        isExpanded ? 'Open Menu' : 'Close Menu',
      );
      
      if (mobileNav) {
        mobileNav.classList.toggle('hidden');
      }
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener('astro:after-swap', toggleNav);
</script>
