---
import Date from './Date.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '~/utils/formatDate';

interface Props {
	href?: string;
	frontmatter: CollectionEntry<'blogs'>['data'];
	secHeading?: boolean;
	slug: string;
	dataTestId?: string;
}
const { href, frontmatter, slug, secHeading = true, dataTestId } = Astro.props;
const { title, pubDate, description, tags } = frontmatter;
const date = formatDate(pubDate);
---

<li class="group" transition:name={slug}>
  <article class="brutalist-card p-5 sm:p-6">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class="brutalist-tag">
        {date}
      </span>
      {tags.slice(0, 3).map((tag) => (
        <a href={`/tags/${tag}`} class="brutalist-tag hover-lift">
          {tag}
        </a>
      ))}
    </div>

    <a 
      href={href} 
      class="block no-underline"
      data-test-id={dataTestId}
    >
      {secHeading ? (
        <h2 class="font-display text-2xl leading-tight tracking-wide text-base transition-colors group-hover:text-accent sm:text-3xl">
          {title}
        </h2>
      ) : (
        <h3 class="font-display text-xl leading-tight tracking-wide text-base transition-colors group-hover:text-accent sm:text-2xl">
          {title}
        </h3>
      )}
    </a>

    <p class="mt-3 font-body text-base leading-relaxed text-base/90">
      {description}
    </p>

    <div class="mt-4 flex items-center gap-2">
      <a 
        href={href}
        class="brutalist-link group/link inline-flex items-center gap-1 font-ui text-sm font-semibold uppercase tracking-wider"
        data-test-id={`${dataTestId}-read-more`}
      >
        Read more
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="16" 
          height="16" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2.5" 
          stroke-linecap="square" 
          stroke-linejoin="miter"
          class="transition-transform group-hover/link:translate-x-1"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </article>
</li>

<style>
  /* Brutalist card */
  .brutalist-card {
    border: 3px solid rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-card-rgb));
    box-shadow: 4px 4px 0 0 rgb(var(--color-text-base));
    transition: all 0.15s ease;
  }

  .brutalist-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 rgb(var(--color-accent-rgb));
  }

  /* Brutalist tag/chip */
  .brutalist-tag {
    display: inline-block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.75rem;
    border: 2px solid rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-fill-rgb));
    color: rgb(var(--color-text-base));
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .brutalist-tag:hover {
    background-color: rgb(var(--color-accent-rgb));
    color: rgb(var(--color-fill-rgb));
    border-color: rgb(var(--color-accent-rgb));
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 0 rgb(var(--color-text-base));
  }

  /* Link with arrow */
  .brutalist-link {
    color: rgb(var(--color-accent-rgb));
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: all 0.15s ease;
  }

  .brutalist-link:hover {
    text-decoration-thickness: 3px;
  }

  /* No underline utility */
  .no-underline {
    text-decoration: none;
  }

  .no-underline:hover {
    text-decoration: none;
  }
</style>
