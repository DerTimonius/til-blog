---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '~/utils/formatDate';

interface Props {
	href?: string;
	frontmatter: CollectionEntry<'blogs'>['data'];
	secHeading?: boolean;
	slug: string;
	dataTestId?: string;
}
const { href, frontmatter, slug, secHeading = true, dataTestId } = Astro.props;
const { title, pubDate, description, tags } = frontmatter;
const date = formatDate(pubDate);

const cardClasses =
	'border-[3px] border-line bg-card shadow-[4px_4px_0_0_rgb(var(--color-text-base))] transition-all duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_rgb(var(--color-accent-rgb))]';

const tagClasses =
	'inline-block font-ui text-[0.7rem] font-semibold uppercase tracking-wider py-[0.35rem] px-3 border-2 border-line bg-fill text-base no-underline transition-all duration-150 hover:bg-accent hover:text-inverted hover:border-accent hover:-translate-x-px hover:-translate-y-px hover:shadow-[2px_2px_0_0_rgb(var(--color-text-base))]';

const linkClasses =
	'text-accent underline decoration-2 underline-offset-[3px] transition-all duration-150 hover:decoration-[3px]';

const noUnderlineClasses = 'no-underline hover:no-underline';
---

<li class="group" transition:name={slug}>
  <article class={`${cardClasses} p-5 sm:p-6`}>
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class={tagClasses}>
        {date}
      </span>
      {tags.slice(0, 3).map((tag) => (
        <a href={`/tags/${tag}`} class={`${tagClasses} hover:-translate-x-px hover:-translate-y-px`}>
          {tag}
        </a>
      ))}
    </div>

    <a 
      href={href} 
      class={`block ${noUnderlineClasses}`}
      data-test-id={dataTestId}
    >
      {secHeading ? (
        <h2 class="font-display text-2xl leading-tight tracking-wide text-base transition-colors group-hover:text-accent sm:text-3xl">
          {title}
        </h2>
      ) : (
        <h3 class="font-display text-xl leading-tight tracking-wide text-base transition-colors group-hover:text-accent sm:text-2xl">
          {title}
        </h3>
      )}
    </a>

    <p class="mt-3 font-body text-base leading-relaxed text-base/90">
      {description}
    </p>

    <div class="mt-4 flex items-center gap-2">
      <a 
        href={href}
        class={`${linkClasses} group/link inline-flex items-center gap-1 font-ui text-sm font-semibold uppercase tracking-wider`}
        data-test-id={`${dataTestId}-read-more`}
      >
        Read more
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="16" 
          height="16" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2.5" 
          stroke-linecap="square" 
          stroke-linejoin="miter"
          class="transition-transform group-hover/link:translate-x-1"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </article>
</li>
