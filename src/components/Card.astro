---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '~/utils/formatDate';

interface Props {
	href?: string;
	frontmatter: CollectionEntry<'blogs'>['data'];
	secHeading?: boolean;
	slug: string;
	dataTestId?: string;
}
const { href, frontmatter, slug, secHeading = true, dataTestId } = Astro.props;
const { title, pubDate, description, tags } = frontmatter;
const date = formatDate(pubDate);
---

<article
	class="group border-[3px] border-line bg-card p-5 shadow-[4px_4px_0_0_rgb(var(--color-text-base))] transition-all duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_rgb(var(--color-accent-rgb))] sm:p-6"
	transition:name={slug}
>
	<div class="mb-4 flex flex-wrap items-center gap-2">
		<span
			class="inline-block border-2 border-line bg-fill px-3 py-[0.35rem] font-ui text-[0.7rem] font-semibold tracking-wider text-base uppercase no-underline transition-all duration-150 hover:-translate-x-px hover:-translate-y-px hover:border-accent hover:bg-accent hover:text-inverted hover:shadow-[2px_2px_0_0_rgb(var(--color-text-base))]"
		>
			{date}
		</span>
		{
			tags.slice(0, 3).map((tag) => (
				<a
					href={`/tags/${tag}`}
					class="inline-block border-2 border-line bg-fill px-3 py-[0.35rem] font-ui text-[0.7rem] font-semibold tracking-wider text-base uppercase no-underline transition-all duration-150 hover:-translate-x-px hover:-translate-y-px hover:border-accent hover:bg-accent hover:text-inverted hover:shadow-[2px_2px_0_0_rgb(var(--color-text-base))]"
				>
					{tag}
				</a>
			))
		}
	</div>

	<a
		href={href}
		class="block no-underline hover:no-underline"
		data-test-id={dataTestId}
	>
		{
			secHeading ? (
				<h2 class="font-display text-2xl leading-tight tracking-wide text-base transition-colors group-hover:text-accent sm:text-3xl">
					{title}
				</h2>
			) : (
				<h3 class="font-display text-xl leading-tight tracking-wide text-base transition-colors group-hover:text-accent sm:text-2xl">
					{title}
				</h3>
			)
		}
	</a>

	<p class="mt-3 font-body leading-relaxed text-base text-base/90">
		{description}
	</p>

	<div class="mt-4 flex items-center gap-2">
		<a
			href={href}
			class="group/link inline-flex items-center gap-1 font-ui text-sm font-semibold tracking-wider text-accent uppercase underline decoration-2 underline-offset-[3px] transition-all duration-150 hover:decoration-[3px]"
			data-test-id={`${dataTestId}-read-more`}
		>
			Read more
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="square"
				stroke-linejoin="miter"
				class="transition-transform group-hover/link:translate-x-1"
			>
				<line x1="5" y1="12" x2="19" y2="12"></line>
				<polyline points="12 5 19 12 12 19"></polyline>
			</svg>
		</a>
	</div>
</article>
