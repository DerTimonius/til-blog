<button
  id="btt"
  class="brutalist-back-to-top"
  aria-label="Back to top"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="square"
    stroke-linejoin="miter"
  >
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
</button>

<style>
  .brutalist-back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: none;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 3px solid rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-accent-rgb));
    color: rgb(var(--color-fill-rgb));
    box-shadow: 4px 4px 0 0 rgb(var(--color-text-base));
    cursor: pointer;
    transition: all 0.15s ease;
    z-index: 50;
  }

  .brutalist-back-to-top:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 0 rgb(var(--color-text-base));
  }

  .brutalist-back-to-top:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 0 rgb(var(--color-text-base));
  }

  .brutalist-back-to-top.block {
    display: flex;
  }
</style>

<script>
  const button = document.getElementById('btt');
  function visible() {
    if (
      document.body.scrollTop > 360 ||
      document.documentElement.scrollTop > 360
    ) {
      button?.classList.add('block');
      button?.classList.remove('hidden');
    } else {
      button?.classList.remove('block');
      button?.classList.add('hidden');
    }
  }
  window.onscroll = function () {
    visible();
  };

  function backToTop() {
    button?.addEventListener('click', () => {
      document.body.scrollTop = 0;
      document.documentElement.scrollTop = 0;
    });
  }
  backToTop();

  // Re-run on view transitions
  document.addEventListener('astro:after-swap', () => {
    window.onscroll = function () {
      visible();
    };
    backToTop();
  });
</script>
