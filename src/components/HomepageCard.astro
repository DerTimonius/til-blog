---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '~/utils/formatDate';

interface Props {
	href: string;
	frontmatter: CollectionEntry<'blogs'>['data'];
	slug: string;
	dataTestId?: string;
}
const { href, frontmatter, slug, dataTestId } = Astro.props;
const { title, pubDate, description, tags } = frontmatter;
const date = formatDate(pubDate);
---

<li class="group" transition:name={slug}>
  <a 
    href={href}
    class="block border-b-[3px] border-line py-8 transition-all hover:bg-card hover:px-4 sm:py-10"
    data-test-id={dataTestId}
  >
    <article class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-6">
      <!-- Date column -->
      <div class="flex-shrink-0 sm:w-28">
        <span class="font-ui text-sm font-semibold uppercase tracking-wider text-accent">
          {date}
        </span>
      </div>

      <!-- Content column -->
      <div class="flex-1 space-y-3">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="inline-block font-ui text-[0.65rem] font-semibold uppercase tracking-wider py-[0.2rem] px-2 border-2 border-line text-base opacity-80">{tag}</span>
          ))}
        </div>

        <!-- Title -->
        <h2 class="font-display text-2xl leading-tight tracking-wide text-base transition-colors group-hover:text-accent sm:text-3xl">
          {title}
        </h2>

        <!-- Description -->
        <p class="font-body text-base leading-relaxed text-base/80 max-w-2xl">
          {description}
        </p>

        <!-- Read more indicator -->
        <div class="inline-flex items-center gap-2 pt-2 font-ui text-sm font-semibold uppercase tracking-wider text-accent">
          <span>Read article</span>
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            width="16" 
            height="16" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2.5" 
            stroke-linecap="square" 
            stroke-linejoin="miter"
            class="transition-transform group-hover:translate-x-1"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </div>
    </article>
  </a>
</li>
