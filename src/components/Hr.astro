---
import classNames from 'classnames';

export interface Props {
	noPadding?: boolean;
	ariaHidden?: boolean;
	className?: string;
	lineColor?: string;
}

const {
	noPadding = false,
	ariaHidden = true,
	className,
	lineColor,
} = Astro.props;
const divClasses = classNames('mx-auto w-full', className, {
	'px-0': noPadding,
	'px-4': !noPadding,
});
---

<div class={divClasses}>
	<hr
		class={lineColor ?? 'border-[3px] border-line'}
		aria-hidden={ariaHidden}
	/>
</div>
