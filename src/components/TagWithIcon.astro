---
import type { Tag } from '~/utils/getTags';
import { tagIcons } from '~/utils/tagIcons';

export interface Props {
	tag: Tag;
}

const { tag } = Astro.props;
const randomIdx = Math.floor(Math.random() * tagIcons.other.length);
const icon =
	tagIcons[tag.name as keyof typeof tagIcons] ?? tagIcons.other[randomIdx];

const cardClasses = 'flex flex-col items-center gap-4 p-6 sm:p-4 border-[3px] border-line bg-fill shadow-[4px_4px_0_0_rgb(var(--color-text-base))] transition-all duration-150 no-underline hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[7px_7px_0_0_rgb(var(--color-accent-rgb))] hover:border-accent';

const iconClasses = 'flex items-center justify-center w-16 h-16 border-2 border-line bg-card transition-all duration-150 group-hover:bg-accent group-hover:border-accent [&_svg]:w-8 [&_svg]:h-8 [&_svg]:fill-base group-hover:[&_svg]:fill-inverted';

const infoClasses = 'flex flex-col items-center gap-1 text-center';

const nameClasses = 'font-display text-2xl tracking-wider uppercase text-base transition-colors duration-150 group-hover:text-accent';

const countClasses = 'font-ui text-xs font-semibold uppercase tracking-wider text-base opacity-70';
---

<li class="group">
  <a
    href={`/tags/${tag.name.toLowerCase()}`}
    transition:name={tag.name.toLowerCase()}
    data-test-id="tag"
    class={cardClasses}
  >
    <div
      class={iconClasses}
      transition:name={`icon-${tag.name}`}
    >
      <Fragment set:html={icon} />
    </div>
    <div class={infoClasses}>
      <span class={nameClasses}>{tag.name.toLowerCase()}</span>
      <span class={countClasses}>{tag.count} posts</span>
    </div>
  </a>
</li>
