---
import type { Tag } from '~/utils/getTags';
import { tagIcons } from '~/utils/tagIcons';
import { Icon } from 'astro-icon/components';

export interface Props {
	tag: Tag;
}

const { tag } = Astro.props;
const icon = tagIcons[tag.name as keyof typeof tagIcons] ?? tagIcons.fallback;
---

<li class="group">
	<a
		href={`/tags/${tag.name.toLowerCase()}`}
		transition:name={tag.name.toLowerCase()}
		data-test-id="tag"
		class="flex flex-col items-center gap-4 border-[3px] border-line bg-fill p-6 no-underline shadow-[4px_4px_0_0_rgb(var(--color-text-base))] transition-all duration-150 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:border-accent hover:shadow-[7px_7px_0_0_rgb(var(--color-accent-rgb))] sm:p-4"
	>
		<div
			class="flex h-16 w-16 items-center justify-center border-2 border-line bg-card transition-all duration-150 group-hover:border-accent group-hover:bg-accent [&_svg]:h-8 [&_svg]:w-8 [&_svg]:stroke-base group-hover:[&_svg]:stroke-inverted"
			transition:name={`icon-${tag.name}`}
		>
			<Icon name={icon} />
		</div>
		<div class="flex flex-col items-center gap-1 text-center">
			<span
				class="font-display text-2xl tracking-wider text-base uppercase transition-colors duration-150 group-hover:text-accent"
				>{tag.name.toLowerCase()}</span
			>
			<span
				class="font-ui text-xs font-semibold tracking-wider text-base uppercase opacity-70"
				>{tag.postsCount} posts</span
			>
		</div>
	</a>
</li>
