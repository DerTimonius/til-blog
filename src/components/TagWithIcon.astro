---
import type { Tag } from '~/utils/getTags';
import { tagIcons } from '~/utils/tagIcons';

export interface Props {
	tag: Tag;
}

const { tag } = Astro.props;
const Icon = tagIcons[tag.name as keyof typeof tagIcons] ?? tagIcons.fallback;
---

<li class="group">
  <a
    href={`/tags/${tag.name.toLowerCase()}`}
    transition:name={tag.name.toLowerCase()}
    data-test-id="tag"
    class="flex flex-col items-center gap-4 p-6 sm:p-4 border-[3px] border-line bg-fill shadow-[4px_4px_0_0_rgb(var(--color-text-base))] transition-all duration-150 no-underline hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[7px_7px_0_0_rgb(var(--color-accent-rgb))] hover:border-accent"
  >
    <div
      class="flex items-center justify-center w-16 h-16 border-2 border-line bg-card transition-all duration-150 group-hover:bg-accent group-hover:border-accent [&_svg]:w-8 [&_svg]:h-8 [&_svg]:stroke-base group-hover:[&_svg]:stroke-inverted"
      transition:name={`icon-${tag.name}`}
    >
      <Icon />
    </div>
    <div class="flex flex-col items-center gap-1 text-center">
      <span class="font-display text-2xl tracking-wider uppercase text-base transition-colors duration-150 group-hover:text-accent">{tag.name.toLowerCase()}</span>
      <span class="font-ui text-xs font-semibold uppercase tracking-wider text-base opacity-70">{tag.postsCount} posts</span>
    </div>
  </a>
</li>
