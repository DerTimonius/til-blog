---
import { Image } from 'astro:assets';

interface Props {
	username?: string;
	postId: string;
}

interface BlueskyPost {
	post: {
		author: {
			avatar: string;
			displayName: string;
			handle: string;
		};
		record: {
			text: string;
		};
		indexedAt: string;
		likeCount: number;
		repostCount: number;
		replyCount: number;
	};
	replies?: BlueskyPost[];
}

const { username = 'dertimonius.eu', postId } = Astro.props as Props;

const blueskyLink = `https://bsky.app/profile/${username}/post/${postId}`;

let comments: BlueskyPost[] = [];
let error = null;

const uri = `at://${username}/app.bsky.feed.post/${postId}`;

try {
	const endpoint = `https://api.bsky.app/xrpc/app.bsky.feed.getPostThread?uri=${encodeURIComponent(uri)}`;

	const response = await fetch(endpoint, {
		method: 'GET',
		headers: {
			Accept: 'application/json',
		},
	});

	if (!response.ok) {
		throw new Error(`Failed to fetch comments: ${response.status}`);
	}

	const data = (await response.json()) as {
		thread?: { replies: BlueskyPost[] };
	};

	if (data.thread?.replies && data.thread.replies.length) {
		comments = data.thread.replies;
	}
} catch (e) {
	error = (e as { message: string }).message;
	// biome-ignore lint/suspicious/noConsole: okay to use
	console.error('Error:', e);
}

const containerClasses = 'font-body';

const linkClasses =
	'inline-flex items-center gap-2 font-ui text-sm font-semibold uppercase tracking-wider py-2 px-4 border-2 border-accent bg-fill text-accent no-underline transition-all duration-150 hover:bg-accent hover:text-inverted hover:no-underline';

const boxClasses =
	'flex flex-col items-center gap-3 p-8 border-[3px] border-line bg-card text-center text-base';

const errorBoxClasses = 'border-accent';

const commentClasses =
	'border-[3px] border-line bg-card p-4 transition-all duration-150 hover:shadow-[4px_4px_0_0_rgb(var(--color-text-base))]';

const repliesClasses =
	'mt-4 pl-6 border-l-[3px] border-accent flex flex-col gap-3';

const replyClasses = 'p-3 bg-fill/50 border-2 border-line';
---

<div class={containerClasses}>
	<div
		class="mb-6 flex items-center justify-between border-b-[3px] border-line pb-4"
	>
		<h2 class="font-display text-2xl tracking-wide">Comments</h2>
		<a
			href={blueskyLink}
			target="_blank"
			rel="noopener noreferrer"
			class={linkClasses}
		>
			<span>Reply on Bluesky</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="square"
				stroke-linejoin="miter"
			>
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
				></path>
				<polyline points="15 3 21 3 21 9"></polyline>
				<line x1="10" y1="14" x2="21" y2="3"></line>
			</svg>
		</a>
	</div>

	{
		error && (
			<div class={`${boxClasses} ${errorBoxClasses}`}>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="square"
					stroke-linejoin="miter"
				>
					<circle cx="12" cy="12" r="10" />
					<line x1="12" y1="8" x2="12" y2="12" />
					<line x1="12" y1="16" x2="12.01" y2="16" />
				</svg>
				<p class="font-ui text-sm font-semibold tracking-wider uppercase">
					Error loading comments
				</p>
				<p class="font-body text-sm opacity-70">{error}</p>
			</div>
		)
	}

	{
		!error && comments.length === 0 && (
			<div class={boxClasses}>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="32"
					height="32"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="square"
					stroke-linejoin="miter"
				>
					<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
				</svg>
				<p class="font-ui text-sm font-semibold tracking-wider uppercase">
					No comments yet
				</p>
				<p class="font-body text-sm opacity-70">
					Be the first to join the conversation
				</p>
			</div>
		)
	}

	{
		!error && comments.length > 0 && (
			<div class="comments-list space-y-4">
				{comments.map((comment) => (
					<div class={commentClasses}>
						<div class="flex items-start gap-4">
							<Image
								inferSize
								src={comment.post.author.avatar}
								alt={`${comment.post.author.displayName}'s avatar`}
								class="h-12 w-12 border-[2px] border-line object-cover"
							/>
							<div class="min-w-0 flex-1">
								<div class="mb-2 flex flex-wrap items-center gap-2">
									<span class="font-ui font-semibold text-base">
										{comment.post.author.displayName}
									</span>
									<span class="font-ui text-sm text-accent">
										@{comment.post.author.handle}
									</span>
								</div>
								<p class="font-body leading-relaxed text-base">
									{comment.post.record.text}
								</p>
								<div class="mt-3 flex items-center justify-between border-t-[2px] border-line pt-2">
									<div class="flex gap-4 font-ui text-sm">
										<span class="flex items-center gap-1">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="14"
												height="14"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="square"
												stroke-linejoin="miter"
											>
												<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
											</svg>
											{comment.post.replyCount || 0}
										</span>
										<span class="flex items-center gap-1">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="14"
												height="14"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="square"
												stroke-linejoin="miter"
											>
												<polyline points="17 1 21 5 17 9" />
												<path d="M3 11V9a4 4 0 0 1 4-4h14" />
												<polyline points="7 23 3 19 7 15" />
												<path d="M21 13v2a4 4 0 0 1-4 4H3" />
											</svg>
											{comment.post.repostCount || 0}
										</span>
										<span class="flex items-center gap-1">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="14"
												height="14"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="square"
												stroke-linejoin="miter"
											>
												<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
											</svg>
											{comment.post.likeCount || 0}
										</span>
									</div>
									<time
										datetime={comment.post.indexedAt}
										class="font-ui text-xs tracking-wider uppercase opacity-60"
									>
										{new Date(comment.post.indexedAt).toLocaleDateString()}
									</time>
								</div>
							</div>
						</div>

						{comment.replies && comment.replies.length > 0 && (
							<div class={repliesClasses}>
								{comment.replies.map((reply) => (
									<div class={replyClasses}>
										<div class="flex items-start gap-3">
											<Image
												src={reply.post.author.avatar}
												alt={`${reply.post.author.displayName}'s avatar`}
												class="h-10 w-10 border-[2px] border-line object-cover"
												inferSize
											/>
											<div class="min-w-0 flex-1">
												<div class="mb-1 flex flex-wrap items-center gap-2">
													<span class="font-ui text-sm font-semibold">
														{reply.post.author.displayName}
													</span>
													<span class="font-ui text-xs text-accent">
														@{reply.post.author.handle}
													</span>
												</div>
												<p class="font-body text-sm leading-relaxed">
													{reply.post.record.text}
												</p>
												<div class="mt-2 flex items-center justify-between">
													<div class="flex gap-3 font-ui text-xs">
														<span>{reply.post.replyCount || 0} 💬</span>
														<span>{reply.post.repostCount || 0} 🔁</span>
														<span>{reply.post.likeCount || 0} ❤️</span>
													</div>
													<time
														datetime={reply.post.indexedAt}
														class="font-ui text-xs tracking-wider uppercase opacity-60"
													>
														{new Date(
															reply.post.indexedAt,
														).toLocaleDateString()}
													</time>
												</div>
											</div>
										</div>
									</div>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		)
	}
</div>
