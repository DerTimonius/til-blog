---
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, '');
const breadcrumbList = currentUrlPath.split('/').slice(1);
const breadcrumbListLength = breadcrumbList.length;
---

<nav class="mx-auto mb-6 mt-8 w-full max-w-4xl px-4 sm:px-6" aria-label="breadcrumb">
  <ul class="flex flex-wrap items-center gap-2 font-ui text-sm font-medium uppercase tracking-wider">
    <li class="inline">
      <a 
        class="brutalist-crumb" 
        href="/"
      >
        Home
      </a>
    </li>
    <li aria-hidden="true" class="text-accent">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbListLength ? (
          <li>
            <span 
              class="brutalist-crumb-active" 
              aria-current="page"
            >
              {breadcrumb.replace(/-/g, ' ')}
            </span>
          </li>
        ) : (
          <>
            <li>
              <a 
                href={`/${breadcrumb}`}
                class="brutalist-crumb"
              >
                {breadcrumb.replace(/-/g, ' ')}
              </a>
            </li>
            <li aria-hidden="true" class="text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </li>
          </>
        ),
      )
    }
  </ul>
</nav>

<style>
  .brutalist-crumb {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 2px solid transparent;
    color: rgb(var(--color-text-base));
    text-decoration: none;
    opacity: 0.7;
    transition: all 0.15s ease;
  }

  .brutalist-crumb:hover {
    opacity: 1;
    border-color: rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-card-rgb));
    box-shadow: 2px 2px 0 0 rgb(var(--color-text-base));
    transform: translate(-1px, -1px);
  }

  .brutalist-crumb-active {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 2px solid rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-accent-rgb));
    color: rgb(var(--color-fill-rgb));
  }
</style>
